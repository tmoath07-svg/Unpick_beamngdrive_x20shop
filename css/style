:root{--bg:#101114;--pn:#191B20;--bd:#30333A;--ac:#E6A23C;--tx:#fff}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:16px system-ui,'Segoe UI',Tahoma,sans-serif}
header{position:sticky;top:0;z-index:5;background:var(--pn);border-bottom:1px solid var(--bd);padding:8px 12px}
.logo{color:var(--ac);letter-spacing:1px}nav{display:flex;gap:6px;overflow-x:auto;margin-top:6px}
nav button{flex:none;min-height:44px;padding:0 14px;background:none;color:var(--tx);border:1px solid var(--bd);border-radius:8px;font:inherit}
nav button.on{background:var(--ac);color:#000;border-color:var(--ac)}
main{padding:12px;max-width:1100px;margin:auto}h2{margin:.3em 0}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}
.btn,input,select,button{min-height:44px;font:inherit;color:var(--tx);background:var(--pn);border:1px solid var(--bd);border-radius:8px;padding:0 12px}
.btn{display:inline-flex;align-items:center;cursor:pointer}.btn.acc{background:var(--ac);color:#000;border-color:var(--ac)}
.btn.danger{border-color:#c0504d;color:#ff8f8c}.btn.big{min-height:56px;padding:0 24px}
input[type=color]{padding:2px;width:52px}input[type=range]{padding:0}
.panel{background:var(--pn);border:1px solid var(--bd);border-radius:8px;padding:10px}.muted{opacity:.7;font-size:14px}
table{border-collapse:collapse;width:100%}th,td{border:1px solid var(--bd);padding:8px;text-align:start;vertical-align:top}th{color:var(--ac);width:120px}
#tree{max-height:60vh;overflow:auto}#tree ul{list-style:none;margin:0;padding-inline-start:18px}#tree summary,#tree .f{padding:9px 6px;cursor:pointer;border-radius:6px}
#tree .on{background:var(--ac);color:#000}
.ed{display:flex;height:60vh;border:1px solid var(--bd);border-radius:8px;background:var(--pn);overflow:hidden;direction:ltr;--fs:14px;--tc:#fff}
.gw{width:52px;overflow:hidden;border-inline-end:1px solid var(--bd);background:#14161a;flex:none}
#gut{padding:10px 6px;text-align:right;color:#777;font-size:var(--fs);line-height:1.5}#gut .bad{background:#7a1f1f;color:#fff}
.tw{position:relative;flex:1;overflow:hidden}
#hl,#ta{position:absolute;top:0;left:0;margin:0;padding:10px;font-size:var(--fs);line-height:1.5;white-space:pre;tab-size:2;border:0;text-align:inherit}
#hl{color:var(--tc);pointer-events:none;min-width:100%}#ta{width:100%;height:100%;background:transparent;color:transparent;caret-color:#fff;resize:none;overflow:auto;border-radius:0;outline:0}
.c{color:#6a9955}.s{color:#ce9178}.n{color:#b5cea8}.k{color:#569cd6}.p{color:var(--ac)}
.fprev{padding:8px;border:1px dashed var(--bd);border-radius:8px;margin:6px 0;font-size:20px}
.cvw{background:#000;border:1px solid var(--bd);border-radius:8px;overflow:auto;position:relative}#cv{max-width:100%;touch-action:none;display:block;margin:auto;background:repeating-conic-gradient(#222 0 25%,#2c2c2c 0 50%) 0/20px 20px}
.v3{height:55vh;overflow:hidden}#v3{width:100%;height:100%;display:block;touch-action:none}#vph{position:absolute;top:8px;inset-inline:8px;background:var(--ac);color:#000;padding:6px;border-radius:6px;font-weight:700;text-align:center}
#rl label{display:block;padding:8px}footer{margin-top:16px;border-top:1px solid var(--bd);padding-top:8px}#bar{width:200px;accent-color:var(--ac)}
#log div{font-size:13px;padding:2px 0}#log .err{color:#ff8f8c}
body{padding-bottom:84px;font-size:17px}header{display:flex;align-items:center;justify-content:space-between;gap:8px;background:linear-gradient(#1d2026,#191B20)}
nav{position:fixed;inset:auto 0 0 0;z-index:9;display:flex;background:var(--pn);border-top:1px solid var(--bd);padding:4px 4px calc(4px + env(safe-area-inset-bottom));margin:0;overflow:visible}
nav button{flex:1;min-height:56px;padding:2px;border:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px;color:#aab}nav button span{font-size:20px}nav button small{font-size:11px}
nav button.on{background:none;color:var(--ac);border-top:3px solid var(--ac);border-radius:0}
.btn.wide{width:100%;justify-content:center}.btn.big{font-size:19px}.btn,input,select{border-radius:12px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin:14px 0}
.card{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-height:110px;padding:14px;background:var(--pn);border:1px solid var(--bd);border-radius:16px;text-align:start;cursor:pointer}
.card i{font-style:normal;font-size:28px}.card small{opacity:.65;font-size:13px}.card:active{border-color:var(--ac)}
.panel{border-radius:14px;margin:8px 0}summary{cursor:pointer;min-height:32px;padding:4px 0;font-weight:600}.ok{color:#7ad98b}.warn{color:var(--ac)}.no{color:#ff8f8c}
.fprev{flex:1 1 100%}
html,body{overflow-x:hidden;max-width:100%}main{overflow-x:hidden}#log div,.panel,.muted,#sel{overflow-wrap:anywhere}
.bar>input,.bar>select{min-width:0;flex:1 1 130px;max-width:100%}.bar>.btn{flex:0 0 auto}#tree{overflow-x:auto}
.card{min-width:0}.logo{font-size:15px}header .muted{font-size:12px}
#cf{flex:1 1 100%;overflow-wrap:anywhere;direction:ltr;text-align:start;font-size:14px}
#tree .f{display:flex;justify-content:space-between;gap:8px;direction:ltr;text-align:left;overflow-wrap:anywhere}
#tree summary{direction:ltr;text-align:left}#tree ul{direction:ltr}
