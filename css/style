/* ===== BEAMNG COLORFUL NAVIGATION ===== */

header {
    padding: 14px 16px;
    background: linear-gradient(135deg, #17191f, #222630);
    border-bottom: 2px solid #383d48;
}

.logo {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: 1px;
    color: #ffad32;
    text-shadow: 0 0 14px #ffad3244;
}

nav {
    display: flex;
    gap: 10px;
    margin-top: 15px;
    padding: 5px 2px 12px;
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #ffad32 #242832;
}

nav button {
    flex: 0 0 auto;
    min-width: 125px;
    min-height: 65px;
    padding: 10px 16px;
    border: 2px solid #3a404d;
    border-radius: 15px;
    background: #292e39;
    color: #f5f5f5;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
    transition: .2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    box-shadow: 0 4px 0 #15171c;
}

nav button::before {
    font-size: 21px;
}

nav button[data-t="home"]::before {
    content: "🏠";
}

nav button[data-t="vehicle"]::before {
    content: "🚘";
}

nav button[data-t="explorer"]::before {
    content: "📁";
}

nav button[data-t="texture"]::before {
    content: "🎨";
}

nav button[data-t="code"]::before {
    content: "💻";
}

nav button[data-t="package"]::before {
    content: "📦";
}

nav button[data-t="settings"]::before {
    content: "⚙️";
}

nav button:nth-child(1) {
    border-color: #e5a13b;
}

nav button:nth-child(2) {
    border-color: #42a5f5;
}

nav button:nth-child(3) {
    border-color: #4caf80;
}

nav button:nth-child(4) {
    border-color: #b47aff;
}

nav button:nth-child(5) {
    border-color: #26c6da;
}

nav button:nth-child(6) {
    border-color: #ff8a65;
}

nav button:nth-child(7) {
    border-color: #9e9e9e;
}

nav button.on {
    background: linear-gradient(135deg, #ffb844, #ff8c24);
    color: #171717;
    border-color: #ffd080;
    box-shadow: 0 4px 0 #a95a14, 0 0 16px #ffad3244;
    transform: translateY(-2px);
}

nav button:active {
    transform: scale(.96);
}

@media (max-width: 600px) {
    header {
        padding: 12px;
    }

    .logo {
        font-size: 20px;
    }

    nav button {
        min-width: 118px;
        min-height: 62px;
        font-size: 15px;
    }
}
