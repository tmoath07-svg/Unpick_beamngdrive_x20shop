:root{--bg:#101114;--pn:#191B20;--pn2:#20232A;--bd:#30333A;--bd2:#434856;--ac:#E6A23C;--acs:rgba(230,162,60,.14);--tx:#F4F5F7;--mu:#B9BFCB}
*{box-sizing:border-box}html,body{overflow-x:hidden;max-width:100%}
body{margin:0;background:radial-gradient(900px 400px at 50% -80px,#2a2418,var(--bg) 70%) no-repeat,var(--bg);color:var(--tx);font:17px/1.65 system-ui,'Segoe UI',Tahoma,sans-serif;padding-bottom:92px}
header{position:sticky;top:0;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:12px 16px;background:rgba(16,17,20,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--bd)}
.logo{color:var(--ac);font-size:16px;letter-spacing:1.5px}header .muted{font-size:13px}
main{padding:16px;max-width:1000px;margin:auto;overflow-x:hidden}h2{margin:.2em 0 .5em;font-size:26px}
.muted{color:var(--mu);font-size:15px}.panel,#sel,#log div{overflow-wrap:anywhere}
.panel{background:var(--pn);border:1px solid var(--bd);border-radius:16px;padding:14px;margin:12px 0}
.bar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:12px 0}
button,.btn,input,select{min-height:48px;font:inherit;color:var(--tx);background:var(--pn2);border:1px solid var(--bd2);border-radius:12px;padding:0 14px}
input::placeholder{color:#8d93a0}.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;font-weight:600}
.btn:active,.card:active{transform:scale(.98)}.btn.acc{background:var(--ac);color:#1a1205;border-color:var(--ac)}
.btn.danger{border-color:#d1605c;color:#ffb0ad}.btn.big{min-height:60px;font-size:20px;border-radius:16px}.btn.wide{width:100%}
.bar>input,.bar>select{min-width:0;flex:1 1 140px;max-width:100%}.bar>.btn{flex:0 0 auto}
input[type=color]{padding:3px;width:56px;flex:0 0 56px}input[type=range]{padding:0;accent-color:var(--ac)}
.hero{background:linear-gradient(135deg,#2b2314,var(--pn) 60%);border:1px solid #4a3c1f;border-radius:20px;padding:18px;margin-bottom:14px}
.hero h2{font-size:30px;margin:0 0 6px}.hero p{margin:0 0 14px;color:#e4e6ea}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:12px;margin:14px 0}
.card{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-height:120px;padding:14px;background:var(--pn);border:1px solid var(--bd);border-radius:18px;text-align:start;cursor:pointer;min-width:0}
.card i{font-style:normal;font-size:26px;width:48px;height:48px;display:grid;place-items:center;background:var(--acs);border-radius:14px;margin-bottom:4px}
.card b{font-size:18px}.card small{color:var(--mu);font-size:14px;line-height:1.4}
summary{cursor:pointer;min-height:36px;padding:6px 0;font-weight:700}.ok{color:#7ad98b}.warn{color:var(--ac)}.no{color:#ff9a97}
nav{position:fixed;inset:auto 0 0 0;z-index:9;display:flex;gap:2px;background:rgba(25,27,32,.97);backdrop-filter:blur(8px);border-top:1px solid var(--bd);padding:6px 6px calc(6px + env(safe-area-inset-bottom))}
nav button{flex:1;min-height:58px;min-width:0;padding:2px;border:0;border-radius:14px;background:none;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;color:var(--mu)}
nav button span{font-size:21px}nav button small{font-size:12px;font-weight:600}nav button.on{background:var(--acs);color:var(--ac)}
#tree{max-height:60vh;overflow:auto}#tree ul{list-style:none;margin:0;padding-inline-start:18px;direction:ltr}
#tree summary,#tree .f{padding:10px 8px;border-radius:10px;cursor:pointer;direction:ltr;text-align:left;overflow-wrap:anywhere}
#tree .f{display:flex;justify-content:space-between;gap:8px}#tree .on{background:var(--ac);color:#1a1205}
#cf{flex:1 1 100%;overflow-wrap:anywhere;direction:ltr;text-align:start;font-size:15px;color:var(--mu)}
.ed{display:flex;height:62vh;border:1px solid var(--bd);border-radius:14px;background:#14161a;overflow:hidden;direction:ltr;--fs:14px;--tc:#F4F5F7}
.gw{width:54px;overflow:hidden;border-inline-end:1px solid var(--bd);background:#101216;flex:none}
#gin{position:relative}#gut{margin:0;padding:10px 8px;text-align:right;color:#8f96a3;font:var(--fs)/1.5 monospace}
#gerr{position:absolute;left:0;right:0;height:calc(var(--fs)*1.5);background:rgba(220,60,60,.45);display:none;pointer-events:none}
.tw{position:relative;flex:1;overflow:hidden}
#hl,#ta{position:absolute;top:0;left:0;margin:0;padding:10px;font-size:var(--fs);line-height:1.5;white-space:pre;tab-size:2;border:0;text-align:inherit}
#hl{color:var(--tc);pointer-events:none;min-width:100%}
#ta{width:100%;height:100%;background:transparent;color:transparent;caret-color:#fff;resize:none;overflow:auto;border-radius:0;outline:0}
.ed.plain #hl{display:none}.ed.plain #ta{color:var(--tc)}
.c{color:#7fb36a}.s{color:#e0a07e}.n{color:#c5e0b0}.k{color:#6fb0f0}.p{color:var(--ac)}
.fprev{flex:1 1 100%;padding:10px;border:1px dashed var(--bd2);border-radius:12px;font-size:20px}
.cvw{background:#000;border:1px solid var(--bd);border-radius:14px;overflow:auto;position:relative}
#cv{max-width:100%;touch-action:none;display:block;margin:auto;background:repeating-conic-gradient(#222 0 25%,#2c2c2c 0 50%) 0/20px 20px}
.v3{height:55vh;overflow:hidden}#v3{width:100%;height:100%;display:block;touch-action:none}
#vph{position:absolute;top:8px;inset-inline:8px;background:var(--ac);color:#1a1205;padding:8px;border-radius:10px;font-weight:700;text-align:center}
#rl label{display:block;padding:10px 4px}table{border-collapse:collapse;width:100%}th,td{border:1px solid var(--bd);padding:8px;text-align:start}
footer{margin-top:20px;border-top:1px solid var(--bd);padding-top:10px}#bar{width:100%;height:10px;accent-color:var(--ac)}
#log div{font-size:14px;padding:3px 0;color:var(--mu)}#log .err{color:#ff9a97}
.logo{white-space:nowrap;font-size:15px}@media(max-width:480px){header .muted{display:none}}
